   ],
   "source": [
    "import pandas as pd\n",
    "\n",
    "# Detectar nombre de columna de fecha\n",
    "fecha_col = 'FlightDate'\n",
    " \n",
    "# Convertir columna de fecha a datetime\n",
    "df_clean[fecha_col] = pd.to_datetime(df_clean[fecha_col], errors='coerce')\n",
    "\n",
    "# Función para limpiar HHMM\n",
    "def clean_hhmm(series):\n",
    "    return (\n",
    "        series.astype(str)\n",
    "        .str.replace(r'\\.0$', '', regex=True)   # quitar \".0\"\n",
    "        .str.replace(r'\\D', '', regex=True)     # quitar caracteres no numéricos\n",
    "        .str.zfill(4)                           # rellenar a 4 dígitos\n",
    "        .replace({'NaN': pd.NA, 'nan': pd.NA})\n",
    "    )\n",
    "\n",
    "# Normalizar columnas de tiempo\n",
    "for c in ['CRSDepTime','CRSArrTime','DepTime','ArrTime']:\n",
    "    if c in df_clean.columns:\n",
    "        df_clean[c] = clean_hhmm(df_clean[c])\n",
    "\n",
    "# Crear datetimes programados\n",
    "if 'CRSDepTime' in df_clean.columns:\n",
    "    hhmm = df_clean['CRSDepTime'].dropna()\n",
    "    df_clean.loc[hhmm.index, 'sched_dep_dt'] = pd.to_datetime(df_clean.loc[hhmm.index, fecha_col]) + \\\n",
    "        pd.to_timedelta(hhmm.str[:2].astype(int), unit='h') + \\\n",
    "        pd.to_timedelta(hhmm.str[2:].astype(int), unit='m')\n",
    "\n",
    "if 'CRSArrTime' in df_clean.columns:\n",
    "    hhmm = df_clean['CRSArrTime'].dropna()\n",
    "    df_clean.loc[hhmm.index, 'sched_arr_dt'] = pd.to_datetime(df_clean.loc[hhmm.index, fecha_col]) + \\\n",
    "        pd.to_timedelta(hhmm.str[:2].astype(int), unit='h') + \\\n",
    "        pd.to_timedelta(hhmm.str[2:].astype(int), unit='m')\n",
    "\n",
    "# Crear datetimes reales (solo si existen valores)\n",
    "if 'DepTime' in df_clean.columns:\n",
    "    hhmm = df_clean['DepTime'].dropna()\n",
    "    df_clean.loc[hhmm.index, 'dep_dt'] = pd.to_datetime(df_clean.loc[hhmm.index, fecha_col]) + \\\n",
    "        pd.to_timedelta(hhmm.str[:2].astype(int), unit='h') + \\\n",
    "        pd.to_timedelta(hhmm.str[2:].astype(int), unit='m')\n",
    "\n",
    "if 'ArrTime' in df_clean.columns:\n",
    "    hhmm = df_clean['ArrTime'].dropna()\n",
    "    df_clean.loc[hhmm.index, 'arr_dt'] = pd.to_datetime(df_clean.loc[hhmm.index, fecha_col]) + \\\n",
    "        pd.to_timedelta(hhmm.str[:2].astype(int), unit='h') + \\\n",
    "        pd.to_timedelta(hhmm.str[2:].astype(int), unit='m')\n",
    "\n",
    "print(df_clean[['CRSDepTime','sched_dep_dt','DepTime','dep_dt']].head(10))\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "8d1cca97",
   "metadata": {},
   "source": [
    "Elimino columnas de tiempos originales porque ya cree las variables datetime y no necesito duplicados. Ademas que evidentemente, el tener tantos datos y columnas consume mucho tiempo y recursos. FlightDate la mantengo porque es mas compacto para graficas/analisis que no son por hora,etc."
   ]
  },
