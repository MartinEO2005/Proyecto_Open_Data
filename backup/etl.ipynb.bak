  {
   "cell_type": "code",
   "execution_count": 23,
   "id": "42c3e55c",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Total filas: 3898329\n",
      "Coincidencias con FAA (modelo encontrado): 3597382\n",
      "Sin match (modelo NaN): 300947\n",
      "Porcentaje de cobertura: 92.28%\n",
      "Model desde FAA: 3597382 (92.28%)\n",
      "Model inferidos: 300947 (7.72%)\n",
      "Cobertura final (FAA + inferidos): 100.00%\n"
     ]
    }
   ],
   "source": [
    "import re\n",
    "import pandas as pd\n",
    "\n",
    "def normalize_tail(s):\n",
    "    if pd.isna(s): return s\n",
    "    s = str(s).strip().upper()\n",
    "    s = re.sub(r'[^A-Z0-9]', '', s)\n",
    "    if s == '': return s\n",
    "    if s[0].isdigit(): s = 'N' + s\n",
    "    if s.startswith('NN'): s = s[1:]\n",
    "    return s\n",
    "\n",
    "df = df_clean.copy()\n",
    "faa = pd.read_csv(\"raw data/faa_tailnumbers_filtered.csv\", dtype=str, low_memory=False)\n",
    "\n",
    "# Normalizar matrículas en df\n",
    "df['Tail_Number_norm'] = df['Tail_Number'].astype(str).apply(normalize_tail)\n",
    "\n",
    "# Detectar columna matrícula en FAA y normalizar\n",
    "orig_cols = list(faa.columns)\n",
    "cols_map = {c.lower().replace(' ','').replace('-','').replace('_',''): c for c in orig_cols}\n",
    "candidates_n = ['n-number','n_number','nnumber','registration','registrationnumber','nnum','n']\n",
    "col_n = next((cols_map[c] for c in candidates_n if c in cols_map), None)\n",
    "if col_n is None:\n",
    "    for c in orig_cols:\n",
    "        sample = faa[c].dropna().astype(str).head(50).tolist()\n",
    "        if sample and sum(bool(re.search(r'[A-Z]', v) and re.search(r'\\d', v)) for v in sample) >= 3:\n",
    "            col_n = c\n",
    "            break\n",
    "if col_n is None:\n",
    "    col_n = orig_cols[0]\n",
    "\n",
    "faa['N_NUMBER_norm'] = faa[col_n].astype(str).apply(normalize_tail)\n",
    "\n",
    "# Detectar columnas model y year en FAA\n",
    "col_model = next((cols_map[c] for c in ['model','mfr_mdl_code','maker','modelname','aircraftmodel','mfr_model','mfrmdlcode'] if c in cols_map), None)\n",
    "col_year  = next((cols_map[c] for c in ['yearmfr','year','year_mfr','manufactureyear','yearmanufactured','yearmfg'] if c in cols_map), None)\n",
    "\n",
    "faa['MODEL'] = faa[col_model].astype(str).str.strip() if col_model else pd.NA\n",
    "faa['YEAR_MFR'] = faa[col_year].astype(str).str.strip() if col_year else pd.NA\n",
    "\n",
    "# Merge por matrícula normalizada\n",
    "faa_for_merge = faa[['N_NUMBER_norm','MODEL','YEAR_MFR']].rename(columns={'N_NUMBER_norm':'N_NUMBER'})\n",
    "df = df.merge(faa_for_merge, how='left', left_on='Tail_Number_norm', right_on='N_NUMBER')\n",
    "\n",
    "# Calcular aircraft_age\n",
    "df['FlightDate'] = pd.to_datetime(df.get('FlightDate', pd.Series()), errors='coerce')\n",
    "df['YEAR_MFR'] = pd.to_numeric(df['YEAR_MFR'], errors='coerce')\n",
    "df['aircraft_age'] = df['FlightDate'].dt.year - df['YEAR_MFR']\n",
    "\n",
    "# Cobertura compacta\n",
    "total = len(df)\n",
    "from_faa = df['MODEL'].notna().sum()\n",
    "print(f\"Total filas: {total}\")\n",
    "print(f\"Coincidencias con FAA (modelo encontrado): {from_faa}\")\n",
    "print(f\"Sin match (modelo NaN): {total - from_faa}\")\n",
    "print(f\"Porcentaje de cobertura: {from_faa/total:.2%}\")\n",
    "\n",
    "# Inferir modelos faltantes por Operating_Airline (fallback global si hace falta)\n",
    "air_col = next((c for c in df.columns if c.lower() in ('operating_airline','operator','airline','operatingcarrier')), None)\n",
    "df['Operating_Airline'] = df[air_col].astype(str).fillna('UNKNOWN') if air_col else 'UNKNOWN'\n",
    "\n",
    "mode_by_airline = (df[df['MODEL'].notna()]\n",
    "                   .groupby('Operating_Airline')['MODEL']\n",
    "                   .agg(lambda s: s.mode().iat[0] if not s.mode().empty else pd.NA)\n",
    "                   .to_dict())\n",
    "\n",
    "global_mode = df['MODEL'].dropna().mode()\n",
    "global_mode = global_mode.iat[0] if not global_mode.empty else pd.NA\n",
    "\n",
    "def infer_model(row):\n",
    "    if pd.notna(row['MODEL']) and str(row['MODEL']).lower() != 'nan': return row['MODEL']\n",
    "    a = row['Operating_Airline']\n",
    "    if a in mode_by_airline and pd.notna(mode_by_airline[a]): return mode_by_airline[a]\n",
    "    return global_mode\n",
    "\n",
    "df['MODEL_final'] = df.apply(infer_model, axis=1)\n",
    "df['MODEL_source'] = df.apply(lambda r: 'faa' if pd.notna(r['MODEL']) and str(r['MODEL']).lower()!='nan' else ('inferred' if pd.notna(r['MODEL_final']) else 'missing'), axis=1)\n",
    "\n",
    "# Resultado final: solo las columnas solicitadas\n",
    "out = df[['Tail_Number_norm','N_NUMBER','MODEL','YEAR_MFR','aircraft_age','MODEL_final','MODEL_source']].copy()\n",
    "\n",
    "# Resumen final compacto\n",
    "from_faa = (out['MODEL_source']=='faa').sum()\n",
    "inferred = (out['MODEL_source']=='inferred').sum()\n",
    "final_coverage = (from_faa + inferred) / total if total else 0\n",
    "print(f\"Model desde FAA: {from_faa} ({from_faa/total:.2%})\")\n",
    "print(f\"Model inferidos: {inferred} ({inferred/total:.2%})\")\n",
    "print(f\"Cobertura final (FAA + inferidos): {final_coverage:.2%}\")\n"
   ]
  },
