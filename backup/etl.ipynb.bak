   "source": [
    "# Conteo total de ceros y conteo por columna\n",
    "import pandas as pd\n",
    "data = df\n",
    "\n",
    "total_cells = data.shape[0] * data.shape[1]\n",
    "zero_counts = 0\n",
    "rows = []\n",
    "\n",
    "for c in data.columns:\n",
    "    ser = data[c]\n",
    "    if pd.api.types.is_numeric_dtype(ser):\n",
    "        z = (ser == 0).sum()\n",
    "    else:\n",
    "        z = ser.astype(str).str.strip().isin([\"0\", \"0.0\"]).sum()\n",
    "    pct_rows = (z / len(data)) * 100\n",
    "    rows.append((c, int(z), round(pct_rows, 4)))\n",
    "    zero_counts += int(z)\n",
    "\n",
    "zero_pct_total = (zero_counts / total_cells) * 100 if total_cells > 0 else 0.0\n",
    "\n",
    "zero_df = pd.DataFrame(rows, columns=['column', 'zero_count', 'zero_pct_rows']).sort_values('zero_count', ascending=False).reset_index(drop=True)\n",
    "\n",
    "print(f\"Total celdas: {total_cells:,}\")\n",
    "print(f\"Celdas con valor 0: {zero_counts:,}  ({zero_pct_total:.4f} % del dataset total)\")\n",
    "display(zero_df.head(11)) # solo las primeras 11 tienen 0s y para no hacer tan largo el output\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "ac843e95",
   "metadata": {},
   "source": [
    "Una vez obtenido los porcentajes de 0s y nulos en el dataset hay que ver si se pueden eliminar (dropear) o si, se pueden inferir de alguna manera.\n",
    "\n",
    "1. Aunque son valores que se pueden inferir, ya que el dataset cuenta con un porcentaje muy bajo de nulos (0.8%) lo dropeo.\n",
    "2. Todas las variables que contienen un porcentaje de 0s tienen sentido ya que o son booleanas o tienen posibilidad de serlo."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "e82073a4",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Shape original df: (4078318, 61)\n",
      "Shape df_clean (sin NA): (3944916, 61)\n"
     ]
    }
   ],
   "source": [
    "# Creación de un nuevo DataFrame sin valores NA\n",
    "df_clean = df.copy()\n",
    "df_clean = df_clean.dropna(axis=0, how='any').reset_index(drop=True)\n",
    "print(\"Shape original df:\", df.shape)\n",
    "print(\"Shape df_clean (sin NA):\", df_clean.shape)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "a62ced4d",
   "metadata": {},
   "source": [
    "Elimino columnas que no son necesarias, como las de fecha que son todas derivables de una misma. Las elimino para no sobrecargar tanto a la hora de manejar datos ya que son demasiadas columnas."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "3e333ec4",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Columnas a eliminar (existentes): ['Year', 'Quarter', 'Month', 'DayofMonth', 'DayOfWeek']\n",
      "Shape tras eliminar columnas derivables: (3944916, 56)\n",
      "Shape tras eliminar columnas derivables: (3944916, 56)\n"
     ]
    }
   ],
   "source": [
    "# Eliminar columnas derivables de Date\n",
    "cols_to_drop = ['Year','Quarter','Month','DayofMonth','DayOfWeek']\n",
    "existing = [c for c in cols_to_drop if c in df_clean.columns]\n",
    "print(\"Columnas a eliminar (existentes):\", existing)\n",
    "df_clean = df_clean.drop(columns=existing, errors='ignore')\n",
    "print(\"Shape tras eliminar columnas derivables:\", df_clean.shape)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "7f20e548",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Filas antes: 3944916, Filas después del filtro de distancia (umbral=3): 3944916, Filas eliminadas: 0\n"
     ]
    }
   ],
   "source": [
    "# filtrar por distancia irreal, manteniendo cancelados\n",
    "threshold = 3  # millas\n",
    "before = df_clean.shape[0]\n",
    "\n",
    "# Normalizar nombre de columna Cancelled si hay variantes\n",
    "cancel_col = None\n",
    "for name in ['CANCELLED','Cancelled','Cancelled','Cancelled']:\n",
    "    if name in df_clean.columns:\n",
    "        cancel_col = name\n",
    "        break\n",
    "\n",
    "if 'Distance' not in df_clean.columns:\n",
    "    print(\"Atención: no existe la columna 'Distance' en df_clean.\")\n",
    "else:\n",
    "    # crear máscara: True para filas a mantener\n",
    "    if cancel_col:\n",
    "        keep_mask = (df_clean['Distance'] > threshold) | (df_clean[cancel_col] == 1)\n",
    "    else:\n",
    "        keep_mask = (df_clean['Distance'] > threshold)\n",
    "    df_clean = df_clean[keep_mask].reset_index(drop=True)\n",
    "    after = df_clean.shape[0]\n",
    "    print(f\"Filas antes: {before}, Filas después del filtro de distancia (umbral={threshold}): {after}, Filas eliminadas: {before-after}\")\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "b06f08c7",
   "metadata": {},
   "source": [
    "Normalizo el formato HHMM para que se pueda intepretar correctamente los Strings y no confundirme con minutos, horas, o lo que fuese.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "4fc7e405",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Ejemplo de valores normalizados:\n",
      "CRSDepTime -> ['1133' '0732' '1529' '1435' '1135' '0955' '2139' '1129' '1424' '0954']\n",
      "CRSArrTime -> ['1245' '0849' '1639' '1605' '1240' '2231' '1306' '1524' '1121' '1650']\n",
      "DepTime -> ['1123.0' '728.0' '1514.0' '1430.0' '1135.0' '952.0' '2136.0' '1117.0'\n",
      " '1414.0' '947.0']\n",
      "ArrTime -> ['1228.0' '848.0' '1636.0' '1547.0' '1251.0' '1238.0' '2218.0' '1311.0'\n",
      " '1513.0' '1110.0']\n"
     ]
    }
   ],
   "source": [
    "# Normalizar columnas de tiempo a formato HHMM (strings de 4 dígitos)\n",
    "cols_time = ['CRSDepTime','CRSArrTime','DepTime','ArrTime']\n",
    "\n",
    "for c in cols_time:\n",
    "    if c in df_clean.columns:\n",
    "        # Convertir a string, quitar espacios, rellenar con ceros a la izquierda\n",
    "        df_clean[c] = df_clean[c].astype(str).str.strip().str.zfill(4)\n",
    "        # Reemplazar valores 'NaN' que se convirtieron en string por np.nan\n",
    "        df_clean[c] = df_clean[c].replace({'NaN': pd.NA, 'nan': pd.NA})\n",
    "        \n",
    "print(\"Ejemplo de valores normalizados:\")\n",
    "for c in cols_time:\n",
    "    if c in df_clean.columns:\n",
    "        print(c, \"->\", df_clean[c].dropna().unique()[:10])\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "7e420c3a",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "  CRSDepTime        sched_dep_dt DepTime              dep_dt\n",
      "0       1133 2022-04-04 11:33:00    1123 2022-04-04 11:23:00\n",
      "1       0732 2022-04-04 07:32:00    0728 2022-04-04 07:28:00\n",
      "2       1529 2022-04-04 15:29:00    1514 2022-04-04 15:14:00\n",
      "3       1435 2022-04-04 14:35:00    1430 2022-04-04 14:30:00\n",
      "4       1135 2022-04-04 11:35:00    1135 2022-04-04 11:35:00\n",
      "5       0955 2022-04-04 09:55:00    0952 2022-04-04 09:52:00\n",
      "6       2139 2022-04-04 21:39:00    2136 2022-04-04 21:36:00\n",
      "7       1129 2022-04-04 11:29:00    1117 2022-04-04 11:17:00\n",
      "8       1424 2022-04-04 14:24:00    1414 2022-04-04 14:14:00\n",
