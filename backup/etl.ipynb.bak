   "source": [
    "# conteo de nulos y porcentaje del dataset que representan\n",
    "N = len(df)\n",
    "na_df = pd.DataFrame({\n",
    "    \"column\": df.columns,\n",
    "    \"na_count\": df.isna().sum().values\n",
    "})\n",
    "na_df[\"na_pct\"] = (na_df[\"na_count\"] / N) * 100\n",
    "na_df = na_df.sort_values(\"na_count\", ascending=False).reset_index(drop=True)\n",
    "# Muestro todas las columnas ordenadas por nulos. \n",
    "display(na_df.head(20))\n",
    "\n",
    "# porcentaje total de celdas nulas en todo el dataset\n",
    "total_na = df.isna().sum().sum()\n",
    "total_cells = N * df.shape[1]\n",
    "total_na_pct = (total_na / total_cells) * 100\n",
    "print(f\"Total celdas: {total_cells:,}\")\n",
    "print(f\"Celdas con NA: {total_na:,}  ({total_na_pct:.4f} % del dataset total)\")"
   ]
  },
