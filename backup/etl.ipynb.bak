      "4              0.0              6.0                6.0                6.0\n"
     ]
    }
   ],
   "source": [
    "# Crear la nueva columna como suma de DepDelayMinutes y ArrDelayMinutes\n",
    "df['TotalDelayMinutes'] = df['DepDelayMinutes'].fillna(0) + df['ArrDelayMinutes'].fillna(0)\n",
    "\n",
    "# Reordenar columnas para que TotalDelayMinutes quede después de ArrDelayMinutes\n",
    "cols = list(df.columns)\n",
    "pos = cols.index('ArrDelayMinutes') + 1\n",
    "cols = cols[:pos] + ['TotalDelayMinutes'] + cols[pos:]\n",
    "df = df[cols]\n",
    "\n",
    "# Verificar resultado\n",
    "print(df[['DepDelayMinutes','ArrDelayMinutes','TotalDelayMinutes']].head())\n"
   ]
  },
