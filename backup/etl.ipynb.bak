   "source": [
    "import pandas as pd\n",
    "\n",
    "df_chequeo = pd.read_csv(\"Conbined_Flights_Limpio.csv\", encoding=\"utf-8\")\n",
    "df_chequeo.head()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "441c62f1",
   "metadata": {},
   "source": [
    "**Union con el Dataset de Aeropuertos**\n",
    "\n",
    "Ahora que la limpieza esta terminada paso a unirlo con el otro dataset secundario descargado. Para esto tenia que tener una llave que pueda utilizarse para conbinar ambos datasets como es el IATA Code."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "337060ae",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Faltan coords origen: 23787 / 3944916\n",
      "Faltan coords destino: 24126 / 3944916\n",
      "Origin sin match (ejemplos): ['BQN', 'GUM', 'PPG', 'PSE', 'SJU', 'SPN', 'STT', 'STX']\n",
      "Dest sin match (ejemplos): ['BQN', 'GUM', 'PPG', 'PSE', 'SJU', 'SPN', 'STT', 'STX']\n"
     ]
    }
   ],
   "source": [
    "airports_path = \"raw data/airports.csv\" \n",
    "airports = pd.read_csv(airports_path, dtype=str)\n",
    "\n",
    "airports = airports.rename(columns={col: col.strip() for col in airports.columns})\n",
    "airports = airports[['iata_code','name','latitude_deg','longitude_deg','iso_country']]\n",
    "# Normalizar iata_code y convertir lat/lon a numerico\n",
    "airports['iata_code'] = airports['iata_code'].astype(str).str.strip().str.upper()\n",
    "airports['latitude_deg'] = pd.to_numeric(airports['latitude_deg'], errors='coerce')\n",
    "airports['longitude_deg'] = pd.to_numeric(airports['longitude_deg'], errors='coerce')\n",
    "\n",
    "\n",
    "# Merge para origen (left join)\n",
    "df_merged = df_clean.merge(\n",
    "    airports[['iata_code','latitude_deg','longitude_deg']].rename(\n",
    "        columns={'iata_code':'Origin_iata','latitude_deg':'origin_lat','longitude_deg':'origin_lon'}\n",
    "    ),\n",
    "    how='left',\n",
    "    left_on='Origin',\n",
    "    right_on='Origin_iata'\n",
    ").drop(columns=['Origin_iata'])\n",
    "\n",
    "# Merge para destino (left join)\n",
    "df_merged = df_merged.merge(\n",
    "    airports[['iata_code','latitude_deg','longitude_deg']].rename(\n",
    "        columns={'iata_code':'Dest_iata','latitude_deg':'dest_lat','longitude_deg':'dest_lon'}\n",
    "    ),\n",
    "    how='left',\n",
    "    left_on='Dest',\n",
    "    right_on='Dest_iata'\n",
    ").drop(columns=['Dest_iata'])\n",
    "\n",
    "# Comprobaciones y reporte rapido\n",
    "missing_origin = df_merged['origin_lat'].isna().sum()\n",
    "missing_dest = df_merged['dest_lat'].isna().sum()\n",
    "total = len(df_merged)\n",
    "print(f\"Faltan coords origen: {missing_origin} / {total}\")\n",
    "print(f\"Faltan coords destino: {missing_dest} / {total}\")\n",
    "\n",
    "# Opcional: listar codigos IATA sin match (para inspeccion)\n",
    "missing_orig_codes = (df_merged[df_merged['origin_lat'].isna()]['Origin']\n",
    "                      .drop_duplicates().sort_values().tolist())\n",
    "missing_dest_codes = (df_merged[df_merged['dest_lat'].isna()]['Dest']\n",
    "                      .drop_duplicates().sort_values().tolist())\n",
    "print(\"Origin sin match (ejemplos):\", missing_orig_codes[:20])\n",
    "print(\"Dest sin match (ejemplos):\", missing_dest_codes[:20])\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "f0ff0d04",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Filas sin coords: 46,587 / 3,944,916 (1.181%)\n",
      "De esas: Cancelled 0.0%, Diverted 0.0%\n"
     ]
    }
   ],
   "source": [
    "# Análisis de filas sin coordenadas\n",
    "total = len(df_merged)\n",
    "missing_origin = df_merged['origin_lat'].isna()\n",
    "missing_dest = df_merged['dest_lat'].isna()\n",
    "missing_either = missing_origin | missing_dest\n",
    "n_missing = missing_either.sum()\n",
    "\n",
    "# Porcentajes resumidos\n",
    "pct_missing = n_missing / total * 100\n",
    "pct_cancelled_of_missing = df_merged.loc[missing_either, 'Cancelled'].mean() * 100\n",
    "pct_diverted_of_missing = df_merged.loc[missing_either, 'Diverted'].mean() * 100\n",
    "\n",
    "print(f\"Filas sin coords: {n_missing:,} / {total:,} ({pct_missing:.3f}%)\")\n",
    "print(f\"De esas: Cancelled {pct_cancelled_of_missing:.1f}%, Diverted {pct_diverted_of_missing:.1f}%\")\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "id": "fe1acf9c",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Shape tras dropna: 3,898,329 filas\n"
     ]
    }
   ],
   "source": [
    "df_no_missing_coords = df_merged.dropna(subset=['origin_lat','dest_lat']).reset_index(drop=True)\n",
    "print(f\"Shape tras dropna: {df_no_missing_coords.shape[0]:,} filas\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "8284cb82",
   "metadata": {},
   "outputs": [],
   "source": [
    "df_clean = df_no_missing_coords.copy()\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "2a7c0139",
   "metadata": {},
   "source": [
