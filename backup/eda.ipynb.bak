    "# Qué hace: histogramas y KDE de ArrDelayMinutes y DepDelayMinutes\n",
    "arr = df['ArrDelayMinutes'].dropna()\n",
    "dep = df['DepDelayMinutes'].dropna()\n",
    "\n",
    "sample_size = 200000\n",
    "arr_sample = arr.sample(n=min(len(arr), sample_size), random_state=42)\n",
    "dep_sample = dep.sample(n=min(len(dep), sample_size), random_state=42)\n",
    "\n",
    "plt.figure(figsize=(14,5))\n",
    "\n",
    "plt.subplot(1,2,1)\n",
    "sns.histplot(arr, bins=120, color='#1f77b4', stat='count', alpha=0.6)\n",
    "sns.kdeplot(arr_sample, color='#08306b', lw=1)\n",
    "plt.axvline(15, color='r', linestyle=':', label='Umbral 15 min')\n",
    "plt.title('Distribución ArrDelayMinutes')\n",
    "plt.xlabel('ArrDelayMinutes')\n",
    "plt.ylabel('Frecuencia')\n",
    "plt.legend()\n",
    "\n",
    "plt.subplot(1,2,2)\n",
    "sns.histplot(dep, bins=120, color='#2ca02c', stat='count', alpha=0.6)\n",
    "sns.kdeplot(dep_sample, color='#006d2c', lw=1)\n",
    "plt.axvline(15, color='r', linestyle=':', label='Umbral 15 min')\n",
    "plt.title('Distribución DepDelayMinutes')\n",
