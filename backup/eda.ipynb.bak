  {
   "cell_type": "markdown",
   "id": "764b700c",
   "metadata": {},
   "source": [
    "### **Rama 0:**  Analisis general del Dataset"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 21,
   "id": "ae0e329d",
   "metadata": {},
   "outputs": [],
   "source": [
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "57e1d5ba",
   "metadata": {},
   "source": [
    "1. **grafica para Porcentaje del dataset que tuvo delay (>15 min)**"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 34,
   "id": "61fcd73c",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Total filas: 3,898,329\n",
      "Vuelos delayed (TotalDelayMinutes > 15): 1,082,341 (27.76%)\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 700x400 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "total = len(df)\n",
    "n_delayed_total = int((df['TotalDelayMinutes'] > 15).sum())\n",
    "pct_delayed_total = 100 * n_delayed_total / total\n",
    "\n",
    "print(f\"Total filas: {total:,}\")\n",
    "print(f\"Vuelos delayed (TotalDelayMinutes > 15): {n_delayed_total:,} ({pct_delayed_total:.2f}%)\")\n",
    "\n",
    "plot_df = pd.DataFrame({\n",
    "    \"Estado\": [\"On-time (<=15 min total)\", \"Delayed (>15 min total)\"],\n",
    "    \"Vuelos\": [total - n_delayed_total, n_delayed_total]\n",
    "})\n",
    "\n",
    "plt.figure(figsize=(7,4))\n",
    "sns.barplot(data=plot_df, x=\"Estado\", y=\"Vuelos\", hue=\"Estado\",\n",
    "            palette={\"On-time (<=15 min total)\":\"#2ca02c\", \"Delayed (>15 min total)\":\"#ff7f0e\"},\n",
    "            dodge=False)\n",
    "plt.title('On-time vs Delayed (TotalDelayMinutes > 15)')\n",
    "plt.ylabel('Número de vuelos')\n",
    "for i, row in plot_df.iterrows():\n",
    "    plt.text(i, \n",
    "        row[\"Vuelos\"] + total*0.0025,\n",
    "        f\"{100*row['Vuelos']/total:.2f}%\", \n",
    "        ha='center',\n",
    "        va='bottom', \n",
    "    )\n",
    "plt.legend([],[], frameon=False)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
