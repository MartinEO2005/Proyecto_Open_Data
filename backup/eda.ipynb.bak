   "source": [
    "# Composición global (categorías mutuamente exclusivas)\n",
    "total = len(df)\n",
    "\n",
    "# Definir categorías exclusivas\n",
    "is_cancelled = df['Cancelled'].fillna(0).astype(int) == 1\n",
    "is_diverted = df['Diverted'].fillna(0).astype(int) == 1\n",
    "is_delayed_total = (df['TotalDelayMinutes'] > 15)\n",
    "\n",
    "# Asegurar exclusividad: cancelled/diverted priorizan sobre delayed\n",
    "cond_cancelled = is_cancelled\n",
    "cond_diverted = (~cond_cancelled) & is_diverted\n",
    "cond_delayed_only = (~cond_cancelled) & (~cond_diverted) & is_delayed_total\n",
    "cond_on_time = (~cond_cancelled) & (~cond_diverted) & (~is_delayed_total)\n",
    "\n",
    "n_cancelled = int(cond_cancelled.sum())\n",
    "n_diverted = int(cond_diverted.sum())\n",
    "n_delayed_only = int(cond_delayed_only.sum())\n",
    "n_on_time = int(cond_on_time.sum())\n",
    "\n",
    "print(f\"Total filas: {total:,}\")\n",
    "print(f\"On-time: {n_on_time:,} ({100*n_on_time/total:.2f}%)\")\n",
    "print(f\"Delayed (normales): {n_delayed_only:,} ({100*n_delayed_only/total:.2f}%)\")\n",
    "print(f\"Cancelled: {n_cancelled:,} ({100*n_cancelled/total:.2f}%)\")\n",
    "print(f\"Diverted: {n_diverted:,} ({100*n_diverted/total:.2f}%)\")\n",
    "\n",
    "# Donut chart sobre todo el dataset\n",
    "labels = ['On-time', 'Delayed (>15 min)', 'Cancelled', 'Diverted']\n",
    "sizes = [n_on_time, n_delayed_only, n_cancelled, n_diverted]\n",
    "colors = ['#2ca02c','#ff7f0e','#d62728','#9467bd']\n",
    "\n",
    "plt.figure(figsize=(7,7))\n",
    "plt.pie(sizes, labels=labels, colors=colors, autopct='%1.1f%%', startangle=90, pctdistance=0.75)\n",
    "centre_circle = plt.Circle((0,0),0.50,fc='white')\n",
    "fig = plt.gcf()\n",
    "fig.gca().add_artist(centre_circle)\n",
    "plt.title('Composición global de vuelos (On-time / Delayed / Cancelled / Diverted)')\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n"
   ]
  },
