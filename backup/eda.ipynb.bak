   "source": [
    "# Qué hace: conteos y medias comparativas\n",
    "total = len(df)\n",
    "n_arr_del = int((df['ArrDelayMinutes'] > 15).sum())\n",
    "n_dep_del = int((df['DepDelayMinutes'] > 15).sum())\n",
    "pct_arr_del = 100 * n_arr_del / total\n",
    "pct_dep_del = 100 * n_dep_del / total\n",
    "\n",
    "mean_arr = df['ArrDelayMinutes'].replace([np.inf, -np.inf], np.nan).dropna().mean()\n",
    "mean_dep = df['DepDelayMinutes'].replace([np.inf, -np.inf], np.nan).dropna().mean()\n",
    "\n",
    "print(f\"Vuelos con ArrDelay >15: {n_arr_del:,} ({pct_arr_del:.2f}%)\")\n",
    "print(f\"Vuelos con DepDelay >15: {n_dep_del:,} ({pct_dep_del:.2f}%)\")\n",
    "print(f\"Media ArrDelayMinutes: {mean_arr:.2f} min\")\n",
    "print(f\"Media DepDelayMinutes: {mean_dep:.2f} min\")\n",
    "\n",
    "fig, ax1 = plt.subplots(figsize=(8,5))\n",
    "sns.barplot(x=['ArrDelay>15','DepDelay>15'], y=[n_arr_del, n_dep_del], palette=['#1f77b4','#2ca02c'], ax=ax1)\n",
    "ax1.set_ylabel('Número de vuelos')\n",
    "for i, v in enumerate([n_arr_del, n_dep_del]):\n",
    "    ax1.text(i, v + total*0.002, f\"{v:,}\\n({100*v/total:.2f}%)\", ha='center')\n",
    "\n",
    "ax2 = ax1.twinx()\n",
    "ax2.plot([0,1], [mean_arr, mean_dep], color='k', marker='o', linestyle='--', label='Media (min)')\n",
    "ax2.set_ylabel('Media delay (min)')\n",
    "ax2.legend(loc='upper right')\n",
    "\n",
    "plt.title('Comparativa: ArrDelay>15 vs DepDelay>15 (conteos) y medias')\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
  },
